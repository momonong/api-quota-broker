[Unit]
Description=Fixed Broker operations, activate one disposable worker
Requires=systemd-tmpfiles-setup.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/api-quota-broker-ops/control.sock
Accept=yes
SocketUser=root
SocketGroup=morris
SocketMode=0660
DirectoryMode=0750
MaxConnections=1
MaxConnectionsPerSource=1
Backlog=1
RemoveOnStop=yes
TriggerLimitIntervalSec=60
TriggerLimitBurst=12

[Install]
WantedBy=sockets.target
