{
  "targets": [
    {
      "id": "google-project-unverified",
      "provider": "google",
      "model": "gemini-2.5-flash-lite",
      "account_id": "replace-with-project-id",
      "enabled": false,
      "free_eligible": false,
      "billing_enabled": false,
      "verified_at": null,
      "expires_at": null,
      "source": "Manual AI Studio project tier and rate-limit check required",
      "priority": 0,
      "concurrency_limit": 1,
      "max_output_tokens": 256,
      "quotas": [
        {"bucket": "google:project:replace:rpm", "metric": "requests", "limit": 1, "window": "rolling_minute", "timezone": "UTC"},
        {"bucket": "google:project:replace:tpm", "metric": "input_tokens", "limit": 1, "window": "rolling_minute", "timezone": "UTC"},
        {"bucket": "google:project:replace:rpd", "metric": "requests", "limit": 1, "window": "day", "timezone": "America/Los_Angeles"}
      ]
    },
    {
      "id": "cloudflare-account-unverified",
      "provider": "cloudflare",
      "model": "@cf/meta/llama-3.2-1b-instruct",
      "account_id": "replace-with-account-id",
      "enabled": false,
      "free_eligible": false,
      "billing_enabled": false,
      "verified_at": null,
      "expires_at": null,
      "source": "Manual Workers plan, remaining Neurons and model access check required",
      "priority": 1,
      "concurrency_limit": 1,
      "max_output_tokens": 256,
      "quotas": [
        {"bucket": "cloudflare:account:replace:neurons", "metric": "neurons", "limit": 1, "window": "day", "timezone": "UTC"},
        {"bucket": "cloudflare:account:replace:text-rpm", "metric": "requests", "limit": 1, "window": "rolling_minute", "timezone": "UTC"}
      ]
    }
  ]
}
